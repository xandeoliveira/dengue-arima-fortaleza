lty = 0.7,                         # Tipo de linha
cex = 0.6)                       # Tamanho do texto
plot(ts.data)
lines(train, col="blue")
legend("topright",                      # Posição da legenda
legend = c("Resíduos", "Previsão"),  # Rótulos
col = c("blue", "red"),          # Cores correspondentes
lty = 1,                         # Tipo de linha
cex = 0.6)                       # Tamanho do texto
