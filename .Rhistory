legend = c("Série", "Arima", "Previsão", "Lim. Sup.", "Lim. Inf."),  # Rótulos
col = c("black", "blue", "red", "green", "yellow"),          # Cores correspondentes
lty = 1,                         # Tipo de linha
cex = 0.6)
