# Carregar o dataset
data<-read.table("C:/Users/olive/OneDrive/Área de Trabalho/dataset.csv", TRUE)
# Timeserie
ts.data<-ts(data, start = c(2014, 27), frequency = 52)
# Série
plot(ts.data)
# QQ-Plot
qqnorm(ts.data)
qqline(ts.data)
# Treino com valores até 2023
train<-ts.data
plot(ts.data)
lines(train, col="blue")
## ACF e PACF
par(mfrow=c(1,2))
acf(train)
pacf(train)
# Modelo
fit<-arima(train, order = c(13,0,0))
# Resíduos AR(13)
par(mfrow=c(2,2))
plot(resid(fit))
qqnorm(resid(fit))
qqline(resid(fit))
acf(resid(fit))
pacf(resid(fit))
# Aplicação AR(13)
par(mfrow=c(1,1))
plot(train, ylab="Dados", main="Aplicação AR(13)")
lines(train-fit$resid, col="blue")
forecast<-predict(fit, n.ahead = 52)
forecast
plot(ts.data, ylab="Dados", main="Previsão 2024")
lines(train-fit$resid, col="blue")
lines(forecast$pred, col="red")
lines(forecast$pred+forecast$se*1.96, col="green")
lines(forecast$pred-forecast$se*1.96, col="green")
plot(ts.data, ylab="Dados", main="Previsão segundo semestre 2024")
lines(train-fit$resid, col="blue")
lines(forecast$pred, col="red")
lines(forecast$pred+forecast$se*1.96, col="green")
lines(forecast$pred-forecast$se*1.96, col="green")
write.csv(forecast$pred, "predicao.csv")
write.csv(forecast$pred)
